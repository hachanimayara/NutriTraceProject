APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Domaine public utilisé dans les QR codes (en production, utiliser l'URL HTTPS du site)
NUTRITRACE_PUBLIC_URL="${APP_URL}"

# Google OAuth (credentials from Google Cloud Console; never commit secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Google reCAPTCHA v2 Checkbox
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
GOOGLE_RECAPTCHA_ENABLED=true


# Cartographie distributeur (OSM tiles / service de routage OSRM)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving


OPEN_FOOD_FACTS_USER_AGENT="NutriTrace/1.0 (votre contact)"
OPEN_FOOD_FACTS_PRODUCT_URL=https://world.openfoodfacts.org/api/v3/product
OPEN_FOOD_FACTS_SEARCH_URL=https://search.openfoodfacts.org/search

# Open-Meteo weather forecasts (free endpoint; no API key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT=10
OPEN_METEO_CACHE_TTL=1800
OPEN_METEO_TIMEZONE=Africa/Tunis
WEATHER_RAIN_THRESHOLD_MM=5
WEATHER_HEAVY_RAIN_THRESHOLD_MM=20
WEATHER_HEAT_THRESHOLD_C=35
WEATHER_WIND_THRESHOLD_KMH=35
WEATHER_GUST_THRESHOLD_KMH=50
WEATHER_HUMIDITY_THRESHOLD_PERCENT=80
WEATHER_FROST_THRESHOLD_C=2
WEATHER_ET0_THRESHOLD_MM=5

# Environmental compliance
COMPLIANCE_RENEWAL_WARNING_DAYS=30
